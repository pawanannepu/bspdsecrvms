BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local / Docker SQLite file (ignored when TURSO_DATABASE_URL is set)
DATABASE_FILE=vms.db

# Required for Vercel (hosted SQLite). Create a free DB at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
